cmake_minimum_required(VERSION 3.25)
file(GLOB_RECURSE SOURCES "${ROOT}/core/*.h" "${ROOT}/core/*.cpp")
foreach(SOURCE IN LISTS SOURCES)
  file(READ "${SOURCE}" CONTENT)
  if(CONTENT MATCHES "#[ \t]*include[ \t]*[<\"](Q[A-Za-z]|Qt|windows\\.h|io/|app/|platform/|filesystem)")
    message(FATAL_ERROR "Forbidden core dependency: ${SOURCE}")
  endif()
  file(RELATIVE_PATH RELATIVE "${ROOT}/core" "${SOURCE}")
  string(REGEX MATCH "^[^/]+" MODULE "${RELATIVE}")
  set(ALLOWED_base base)
  set(ALLOWED_geometry base geometry)
  set(ALLOWED_raster base geometry raster)
  set(ALLOWED_composite base geometry raster composite)
  set(ALLOWED_shapes base geometry shapes)
  set(ALLOWED_boolean base geometry boolean)
  set(ALLOWED_document base geometry raster composite shapes document)
  set(ALLOWED_effects base geometry raster composite shapes document effects)
  set(ALLOWED_render base geometry raster composite shapes boolean document effects render)
  set(ALLOWED_history base geometry raster composite shapes document history)
  set(ALLOWED_editing base geometry raster composite shapes boolean document effects render history editing)
  if(NOT DEFINED ALLOWED_${MODULE})
    message(FATAL_ERROR "Unknown core module '${MODULE}': add it to cmake/CheckArchitecture.cmake")
  endif()
  string(REGEX MATCHALL "#[ \t]*include[ \t]*\"[a-z]+/[^\"]+\"" INCLUDES "${CONTENT}")
  foreach(INCLUDE IN LISTS INCLUDES)
    string(REGEX REPLACE ".*\"([a-z]+)/.*" "\\1" DEPENDENCY "${INCLUDE}")
    if(NOT DEPENDENCY IN_LIST ALLOWED_${MODULE})
      message(FATAL_ERROR "${MODULE} cannot depend on ${DEPENDENCY}: ${SOURCE}")
    endif()
  endforeach()
endforeach()
message(STATUS "Core boundaries verified")
